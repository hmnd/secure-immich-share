# Immich on the private network (/api is appended)
IMMICH_URL=http://immich-server:2283
# Public origin of this service; also set it as Immich's external domain
PUBLIC_URL=https://photos.example.com
# 32 random bytes for unlock cookies: openssl rand -base64 32
COOKIE_KEY=

# Link kinds (see README: Immich keys are visible to visitors)
IMMICH_KEY_LINKS=true
IMMICH_SLUG_LINKS=true
# Encrypted /t/ links: id:base64(32 bytes):active|retired[,...]
# LINK_KEYS=1:<openssl rand -base64 32>:active

# Reverse proxies whose X-Forwarded-For is trusted (CIDRs)
TRUSTED_PROXIES=172.16.0.0/12

# CACHE_MAX_BYTES=10GiB
# MAX_SOURCE_BYTES=4GiB
# SANITIZE_CONCURRENCY=4
# SANITIZE_QUEUE=64
# SANITIZE_TIMEOUT=120s
# SHARE_TTL=60s
# SHOW_DESCRIPTIONS=false
# SHOW_DATES=true
# OG_PREVIEWS=true
# PREWARM_VIDEOS=true
# PREWARM_IMAGES=false
# PREWARM_CONCURRENCY=1
# PREWARM_TTL=10m
# FAILED_TTL=10m
# ZIP_JOBS=2
# ZIP_CONCURRENCY=2
# ZIP_TTL=15m
# SHUTDOWN_GRACE=30s
# LOG_LEVEL=info
