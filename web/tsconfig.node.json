{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2024"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true
	},
	"include": ["*.config.js", "*.config.ts", "lint"]
}
